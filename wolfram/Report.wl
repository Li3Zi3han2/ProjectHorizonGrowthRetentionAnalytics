HReport::usage="HReport[] saves primary metrics and an executable narrative notebook.";
HReport[]:=Module[{sections,cells},
 HJSON[HPath["outputs","metrics","wolfram.json"],$HM];
 HJSON[HPath["outputs","metrics","wolfram_environment.json"],<|"version"->$Version,"system"->$System,"system_id"->$SystemID|>];
 sections={{"KPI","daily_kpis.csv"},{"Retention","retention_curve.csv"},{"Core progression funnel","core_funnel.csv"},{"Optional adoption: Chapter3 denominator","optional_adoption.csv"},{"Actual gate / level diagnosis","progression_diagnosis.csv"},{"Multi-session observable features","wolfram_features.csv"},{"Correlated engagement family","feature_correlations.csv"},{"Model interpretation","logistic_coefficients.csv"},{"Segments","segments.csv"},{"Gate experiment eligibility / power","experiment_design.csv"},{"Data quality","data_quality_summary.csv"}};
 cells=Flatten[Map[Function[pair,{Cell[pair[[1]],"Section"],Cell[BoxData["Import[FileNameJoin[{root, \"outputs\", \"tables\", \""<>pair[[2]]<>"\"}], \"Dataset\"]"],"Input"]}],sections]];
 cells=Join[cells,{Cell["Corrected classification metrics; threshold0.5 is diagnostic, operations uses top10% ranking. D7 core-loop unlock is distinct from exact D7 retention.","Text"],Cell[BoxData["Dataset[Import[FileNameJoin[{root, \"outputs\", \"models\", \"wolfram_evaluation.json\"}], \"RawJSON\"]]"],"Input"]}];
 Export[HPath["wolfram","AnalysisWalkthrough.nb"],Notebook[Join[{Cell["Project Horizon: Growth and Retention","Title"],Cell["Fictional game. All data are synthetic. PostgreSQL is the single source of truth.","Text"],Cell["Run the headless pipeline first; notebook cells only present its outputs.","Text"],Cell[BoxData["root = ParentDirectory[NotebookDirectory[]]; summary = Import[FileNameJoin[{root, \"outputs\", \"executive_summary.json\"}], \"RawJSON\"]; Dataset[summary]"],"Input"]},cells,{Cell["Observational association is not a causal effect. Validate interventions with randomized experiments.","Text"]}]],"NB"]];
