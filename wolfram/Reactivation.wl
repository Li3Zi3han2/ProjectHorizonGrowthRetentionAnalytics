HReactivation::usage="HReactivation[] measures patch2 silent-user returns with complete followup.";
HReactivation[]:=Module[{r=First[HSQLFile["08_returning_users.sql"]],profiles,q},Do[$HM["reactivation/"<>k]=r[k],{k,Keys[r]}];$HM["return_rate"]=N[r["returned"]/Max[1,r["eligible"]]];HJSON[HPath["outputs","metrics","reactivation.json"],r];
 q="WITH eligible AS(SELECT u.user_id FROM horizon.users u WHERE register_date<DATE '2026-04-17' AND NOT EXISTS(SELECT 1 FROM horizon.sessions s WHERE s.user_id=u.user_id AND session_date BETWEEN DATE '2026-04-17' AND DATE '2026-04-30')),r AS(SELECT DISTINCT user_id FROM horizon.sessions WHERE session_date BETWEEN DATE '2026-05-01' AND DATE '2026-05-07'),s AS(SELECT user_id,count(DISTINCT session_date) days,sum(session_minutes)::float8 minutes FROM horizon.sessions WHERE session_date<DATE '2026-05-01' GROUP BY user_id),p AS(SELECT user_id,max(chapter) chapter FROM horizon.progression WHERE event_date<DATE '2026-05-01' GROUP BY user_id),m AS(SELECT user_id,sum(amount_usd)::float8 spend FROM horizon.monetization WHERE transaction_date<DATE '2026-05-01' GROUP BY user_id),e AS(SELECT user_id,count(*) social FROM horizon.gameplay_events WHERE event_time<DATE '2026-05-01' AND event_type='social_interaction' GROUP BY user_id) SELECT (r.user_id IS NOT NULL)::int returned,count(*) n,avg(s.days)::float8 history_days,avg(s.minutes)::float8 history_minutes,avg(p.chapter)::float8 history_chapter,avg(coalesce(m.spend,0))::float8 history_spend,avg(coalesce(e.social,0))::float8 history_social FROM eligible x LEFT JOIN r USING(user_id) JOIN s USING(user_id) JOIN p USING(user_id) LEFT JOIN m USING(user_id) LEFT JOIN e USING(user_id) GROUP BY returned ORDER BY returned";
 profiles=HQuery[q];HCSV[HPath["outputs","tables","wolfram_reactivation_profile.csv"],profiles];
 Do[Do[$HM["reactivation/profile/"<>ToString[z["returned"]]<>"/"<>k]=z[k],{k,{"n","history_days","history_minutes","history_chapter","history_spend","history_social"}}],{z,profiles}];r];
