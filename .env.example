# For an existing PostgreSQL instance:
# copy this file to .env and edit the values below.
#
# Windows users who want an isolated local database can instead run:
#   .\tools\start_local_db.ps1
# That helper creates .env automatically and preserves an existing .env.

HORIZON_DB_HOST=localhost
HORIZON_DB_PORT=5432
HORIZON_DB_NAME=project_horizon
HORIZON_DB_USER=your_user
HORIZON_DB_PASSWORD=your_password
# Optional executable paths. Leave empty unless overriding auto-detection.
HORIZON_PYTHON=
HORIZON_WOLFRAM_KERNEL=
# Optional isolated dataset schema; default is horizon.
HORIZON_DB_SCHEMA=horizon
# Existing schema replacement is refused unless explicitly authorized.
# HORIZON_ALLOW_REPLACE=1 preserves the old schema as a recoverable backup.
